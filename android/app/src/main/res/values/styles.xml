<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema mostrado como splash screen antes de que Flutter dibuje su
         primer frame (referenciado desde AndroidManifest.xml). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Tema normal usado una vez que Flutter ya tomó el control de la
         pantalla (también referenciado desde AndroidManifest.xml). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
